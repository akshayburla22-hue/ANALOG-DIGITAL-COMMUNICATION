
clc;
clear;
close all;

% Parameters
Am = 1;          % Message amplitude (V)
fm = 100;        % Message frequency (Hz)
Ac = 5;          % Carrier amplitude (V)
fc = 1000;       % Carrier frequency (Hz)
fs = 20*fc;      % Sampling frequency (Hz)
kp = pi/2;       % Phase sensitivity (rad/V)

% Time Vector
t = 0:1/fs:4/fm;

% Message Signal
m = Am*sin(2*pi*fm*t);

% Phase Modulated Signal
pm = Ac*cos(2*pi*fc*t + kp*m);

% Phase Deviation
beta = kp*Am;

% FFT Calculation
N = length(pm);
Y = fft(pm);

% Frequency Axis
f = (-N/2:N/2-1)*(fs/N);

% Frequency Spectrum
PM_FFT = abs(fftshift(Y))/N;

% Power Spectral Density
PSD = (abs(fftshift(Y)).^2)/(N*fs);

% Approximate Bandwidth (Carson's Rule)
BW = 2*(beta+1)*fm;

% Display Results
fprintf('Phase Deviation = %.2f radians\n', beta);
fprintf('Estimated Bandwidth = %.2f Hz\n', BW);

% Plotting
figure('Name','PM Signal and PSD Analysis');

subplot(2,2,1);
plot(t,m,'b','LineWidth',1.5);
title('Message Signal');
xlabel('Time (s)');
ylabel('Amplitude (V)');
grid on;

subplot(2,2,2);
plot(t,pm,'r','LineWidth',1.2);
title('Phase Modulated Signal');
xlabel('Time (s)');
ylabel('Amplitude (V)');
grid on;

subplot(2,2,3);
plot(f,PM_FFT,'k','LineWidth',1.2);
title('Frequency Spectrum of PM Signal');
xlabel('Frequency (Hz)');
ylabel('Magnitude');
grid on;
xlim([-2000 2000]);

subplot(2,2,4);
plot(f,PSD,'m','LineWidth',1.2);
title('Power Spectral Density');
xlabel('Frequency (Hz)');
ylabel('PSD (V^2/Hz)');
grid on;
xlim([-2000 2000]);

sgtitle('Phase Modulation Analysis');

